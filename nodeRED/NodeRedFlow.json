    {
        "id": "28590ea8f56c5f2f",
        "type": "function",
        "z": "8929c7863b5acbd3",
        "name": "separate ",
        "func": "var input = msg.payload.trim(); // Remove any surrounding whitespace\n\n// Split the input by comma\nvar values = input.split(\",\");\n\n// Ensure there are exactly two values\nif (values.length === 2) {\n    // Construct two separate messages\n    var msg1 = { topic: \"topic1\", payload: Number(values[0]) };\n    var msg2 = { topic: \"topic2\", payload: Number(values[1]) };\n    \n    return [msg1, msg2]; // Send both messages\n} else {\n    node.error(\"Invalid input format\");\n    return null; // or handle the error appropriately\n}",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
